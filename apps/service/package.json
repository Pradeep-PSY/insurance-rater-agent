{
  "name": "insurance-rater-reviewer-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test --pool=threads --maxWorkers=1",
    "sample-traces": "tsx src/draft-trace-cli.ts",
    "start:api": "node --env-file-if-exists=.env dist/src/api.js",
    "start:worker": "node --env-file-if-exists=.env dist/src/worker.js",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch src/api.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.848.0",
    "@aws-sdk/s3-request-presigner": "^3.848.0",
    "express": "^5.1.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
